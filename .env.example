# Copy this file to `.env` and fill in your keys. `.env` is gitignored.

# OpenAI (required for AI metadata enrichment; without it the tool falls back to plain title parsing)
OPENAI_API_KEY=sk-your-openai-key-here
# Firecrawl (optional; without it, web enrichment is skipped)
FIRECRAWL_API_KEY=fc-your-firecrawl-key-here

# Settings
OPENAI_MODEL=gpt-4o-mini
OUTPUT_DIR="~/Music/YouTube Sets"
DEFAULT_FORMAT=alac
PORT=8765

# Encoded full-set masters are kept so re-running an edited set skips the download
# and encode. Least recently used masters go first once the folder passes the cap.
# MASTER_CACHE_BYTES=0 disables the cache.
MASTER_CACHE_DIR=~/.cache/setlist/masters
MASTER_CACHE_BYTES=3221225472

# Optional: local PO-token provider sidecar URL for YouTube bot checks (leave empty to disable)
POT_PROVIDER_URL=

# Optional: comma-separated browser origins allowed to call this API cross-origin
# (the hosted site; see docs/hosted-site.md). Leave empty to disable CORS entirely.
CORS_ORIGINS=https://list-setlist.vercel.app,https://setlist-dusky.vercel.app

# Optional: bearer token protecting the API when exposed through a tunnel (see docs/n8n-integration.md).
# Leave empty to keep the app open (loopback-only use). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=

# Reference copy of the n8n Cloud webhook token (used by the Apple Shortcut and the
# n8n header-auth credential; the Mac app itself never reads this).
N8N_WEBHOOK_TOKEN=

# Cloudflare R2 (planned cloud-worker output storage; see spike/README.md).
# The Modal spike reads these from a Modal Secret named `r2-credentials`, not from
# this file — they are listed here only as a reference for which keys exist.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET=your-bucket-name
