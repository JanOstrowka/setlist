# Settings for running the engine from source (`./run.sh`). Copy to `.env`.
# The packaged Mac app keeps the same keys in
# ~/Library/Application Support/Setlist/settings.env and edits them from Settings….
#
# Setlist needs no account or API key. Everything below is optional and
# already has a sensible default.

# Where finished sets are saved, as Artist/Set/NN - Track.m4a.
OUTPUT_DIR="~/Music/YouTube Sets"

# alac (lossless, larger) or aac256 (smaller).
DEFAULT_FORMAT=alac

# Local port for the engine; change it only if something else uses it.
PORT=8765

# Encoded full-set masters are kept so re-running an edited set skips the
# download and encode. Least recently used masters go first once the folder
# passes the cap; MASTER_CACHE_BYTES=0 disables the cache.
MASTER_CACHE_DIR=~/.cache/setlist/masters
MASTER_CACHE_BYTES=3221225472

# Options for the browser UI and for exposing the API to other tools
# (FIRECRAWL_API_KEY, CORS_ORIGINS, API_AUTH_TOKEN, POT_PROVIDER_URL) are
# described in docs/development.md. The Mac app uses none of them.
